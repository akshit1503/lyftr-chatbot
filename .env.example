# Comma-separated key pool (at least 2). Ids become key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# local (in-memory) or disk (persisted under CACHE_DIR)
CACHE_TYPE=local
CACHE_DIR=/data/cache
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Frontend build-time URL of the backend
VITE_API_URL=http://localhost:8000
